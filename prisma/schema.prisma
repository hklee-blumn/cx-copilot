generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Customer {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  phone         String
  company       String         @default("Unknown")
  isSimulated   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  orders        Order[]
  conversations Conversation[]
}

model Order {
  id             String          @id @default(cuid())
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id])
  description    String
  amountCents    Int
  purchasedAt    DateTime        @default(now())
  status         String          @default("completed")
  refundDecisions RefundDecision[]
}

model Conversation {
  id              String           @id @default(cuid())
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  status          String           @default("ai_active")
  severity        String           @default("green")
  isSimulated     Boolean          @default(false)
  escalateReason  String?
  assignedAgentId String?
  assignedAgent   Agent?           @relation(fields: [assignedAgentId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  messages        Message[]
  refundDecisions RefundDecision[]

  @@index([status, severity, updatedAt])
  @@index([isSimulated, status])
}

model Message {
  id                     String       @id @default(cuid())
  conversationId         String
  conversation           Conversation @relation(fields: [conversationId], references: [id])
  sender                 String
  body                   String
  imageUrl               String?
  photoLooksFake         Boolean?
  photoFakeReason        String?
  photoSupportsRefund    Boolean?
  photoAnalysisReasoning String?
  createdAt              DateTime     @default(now())
}

model RefundDecision {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  orderId        String?
  order          Order?       @relation(fields: [orderId], references: [id])
  amountCents    Int
  decision       String
  reasoning      String
  confidence     Float
  decidedBy      String
  createdAt      DateTime     @default(now())
}

model KbArticle {
  id    String @id @default(cuid())
  title String
  slug  String @unique
  body  String
  tags  String
}

model Agent {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  conversations Conversation[]
}
